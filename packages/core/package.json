{
  "name": "speqkit",
  "version": "0.5.0",
  "description": "The kernel: loads plugins and gets out of the way.",
  "license": "MIT",
  "author": "Stepan Kaziatko",
  "homepage": "https://github.com/speqkit/speqkit#readme",
  "bugs": "https://github.com/speqkit/speqkit/issues",
  "repository": {
    "type": "git",
