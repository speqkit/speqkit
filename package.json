{
  "name": "speqkit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "binary": "node scripts/build-binary.mjs",
    "speq": "node --import tsx packages/core/src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speqkit/speqkit.git"
  }
}
